---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 | Bryce Keeler" description="Page not found.">
  <main class="error-page">
    <div class="error-content">
      <pre class="ruin" aria-hidden="true">
                 +
                /\
               /::\        .
          '   /;##(\      /\
         /\  /(#%%#\\    /;;\
        /!;\/%#'   . \  /(##;\
    _._/;(#%&;  ._   .\/&#. '(\_._
   .:(##%&@#(;  .'  ..;%@&;  .;#):.
      </pre>
      <pre class="code">&#123;
  "404": "not_found",
  "path": <span id="lost-path">"…"</span>,
  "try": [
    <a href="/">"home"</a>,
    <a href="/blog">"blog"</a>,
    <a href="/resume">"resume"</a>
  ]
&#125;</pre>
    </div>
  </main>
</BaseLayout>

<style>
  .error-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }
  .error-content { max-width: 60ch; }
  .ruin {
    margin: 0 0 2rem;
    color: var(--faint);
    font-size: 12px;
    line-height: 1.1;
    user-select: none;
  }
  .code {
    margin: 0;
    color: var(--dim);
    font-size: 0.95rem;
    line-height: 1.7;
  }
  .code a { color: var(--ink); text-decoration: none; }
  .code a:hover { background: var(--bone); color: var(--void); }
  #lost-path { color: var(--ink); }
</style>

<script is:inline>
  const el = document.getElementById('lost-path');
  if (el) el.textContent = JSON.stringify(window.location.pathname);
</script>
