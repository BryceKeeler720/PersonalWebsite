---
import { getCollection, type CollectionEntry } from 'astro:content';
import DocLayout from '../../layouts/DocLayout.astro';
import { getWordCount } from '../../utils/readingTime';

type JournalEntry = CollectionEntry<'journal'>;

export async function getStaticPaths() {
  const entries: JournalEntry[] = await getCollection('journal', ({ data }: JournalEntry) => !data.draft);
  return entries.map((entry: JournalEntry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: JournalEntry };
const { Content } = await entry.render();

const wordCount = getWordCount(entry.body);
const date = entry.data.publishDate.toISOString().slice(0, 10);
---

<DocLayout title={`${entry.data.title} | Journal`} description={`Journal entry: ${entry.data.title}`} crumb="journal" crumbHref="/journal">
  <header>
    <h1 class="post-title">{entry.data.title}</h1>
    <div class="meta">{date} · {wordCount} words</div>
  </header>

  <section class="prose">
    <Content />
  </section>

  {entry.data.tags.length > 0 && (
    <p class="tags">{entry.data.tags.map((t: string) => `#${t.toLowerCase()}`).join(' ')}</p>
  )}
  <p class="meta"><a href="/journal">← all entries</a></p>
</DocLayout>

<style>
  .post-title {
    text-transform: none !important;
    letter-spacing: 0.1ch !important;
    font-size: 1.5rem !important;
    max-width: 78ch;
  }
  .tags { margin-top: 2.5rem; }
  a { color: var(--dim); text-decoration: none; }
</style>
