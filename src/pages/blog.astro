---
import { getCollection, type CollectionEntry } from 'astro:content';
import DocLayout from '../layouts/DocLayout.astro';
import { calculateReadingTime } from '../utils/readingTime';

type BlogPost = CollectionEntry<'blog'>;

const posts: BlogPost[] = (await getCollection('blog', ({ data }: BlogPost) => !data.draft))
  .sort((a: BlogPost, b: BlogPost) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const fmt = (d: Date) => d.toISOString().slice(0, 10);
---

<DocLayout title="Blog | Bryce Keeler" description="Writing on machine learning, trading systems, home labs, and software.">
  <header>
    <h1>Blog</h1>
    <div class="sub">writing on ml · systems · markets</div>
  </header>

  <section>
    <ul class="posts">
      {posts.map((post) => (
        <li>
          <div class="line">
            <span class="date">{fmt(post.data.publishDate)}</span>
            <a href={`/blog/${post.slug}`}>{post.data.title}</a>
            <span class="rt">{calculateReadingTime(post.body)}</span>
          </div>
          <p class="desc">{post.data.description}</p>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>Subscribe</h2>
    <form class="sub-form" action="https://buttondown.com/api/emails/embed-subscribe/BryceKeeler" method="POST" target="_blank">
      <input type="email" name="email" placeholder="your@email.com" required />
      <button type="submit">→ subscribe</button>
    </form>
    <p class="meta">or via <a href="/rss.xml">rss</a> · <a href="/journal">journal</a></p>
  </section>
</DocLayout>

<style>
  .posts { list-style: none; margin: 0; padding: 0; }
  .posts > li {
    padding: 0.8rem 0;
    border-bottom: 1px dashed var(--ghost);
  }
  .line { display: flex; gap: 1.5ch; align-items: baseline; flex-wrap: wrap; }
  .date { color: var(--dim); white-space: nowrap; }
  .line a { color: var(--bone); font-weight: bold; text-decoration: none; letter-spacing: 0.05ch; }
  .line a:hover { background: var(--bone); color: var(--void); }
  .rt { color: var(--faint); font-size: 0.8rem; white-space: nowrap; }
  .desc { margin: 0.3rem 0 0; color: var(--kana-fg-dim); font-size: 0.9rem; max-width: 78ch; }

  .sub-form { display: flex; gap: 1ch; max-width: 48ch; flex-wrap: wrap; }
  .sub-form input {
    flex: 1;
    min-width: 24ch;
    background: transparent;
    border: 1px solid var(--faint);
    color: var(--kana-fg);
    font-family: inherit;
    font-size: 0.9rem;
    padding: 0.4rem 1ch;
    outline: none;
  }
  .sub-form input:focus { border-color: var(--dim); }
  .sub-form button {
    background: transparent;
    border: 1px solid var(--faint);
    color: var(--ink);
    font-family: inherit;
    font-size: 0.9rem;
    padding: 0.4rem 1.5ch;
    cursor: pointer;
  }
  .sub-form button:hover { background: var(--bone); color: var(--void); border-color: var(--bone); }
</style>
