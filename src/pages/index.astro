---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

type BlogPost = CollectionEntry<'blog'>;

const posts: BlogPost[] = (await getCollection('blog', ({ data }: BlogPost) => !data.draft))
  .sort((a: BlogPost, b: BlogPost) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 5);

const fmt = (d: Date) => d.toISOString().slice(0, 10);
---

<BaseLayout title="Bryce Keeler" description="Machine learning engineer. Trading systems, ML infrastructure, and self-hosted hardware.">
  <div id="cathedral" aria-hidden="true"><pre></pre></div>

  <aside id="index">
    <div class="label">INDEX</div>
    <ul>
      <li><span class="tree">├─</span> <a href="#about" data-sec="about">home</a></li>
      <li><span class="tree">├─</span> <a href="#projects" data-sec="projects">projects</a></li>
      <li><span class="tree">├─</span> <a href="#writing" data-sec="writing">writing</a></li>
      <li><span class="tree">├─</span> <a href="#resume" data-sec="resume">resume</a></li>
      <li><span class="tree">└─</span> <a href="#contact" data-sec="contact">contact</a></li>
    </ul>
    <div class="foot">© 2026<br />NO TRACKING</div>
  </aside>

  <div class="page">
    <header class="masthead">
      <h1>BRYCE KEELER</h1>
      <div class="sub">machine learning · software · systems</div>
    </header>

    <section id="about">
      <h2>About</h2>
      <p>
        Machine learning engineer. I build ML systems, trading automation,
        and self-hosted infrastructure.
      </p>
    </section>

    <section id="projects">
      <h2>Projects</h2>
      <ul class="entries">
        <li><span class="k">2signal</span>AI agent evaluation &amp;
            reliability platform. <a class="go" href="https://2signal.dev">→ 2signal.dev</a></li>
        <li><span class="k">trading bot</span>self-learning regime-adaptive
            trading, scanning 6,000+ assets. <a class="go" href="/TradingBot">→ dashboard</a></li>
        <li><span class="k">homelab</span>proxmox server, 15+ containers of
            self-hosted infrastructure. <a class="go" href="/HomeLab">→ tour</a></li>
        <li><span class="k">terminal</span>this site, as a shell.
            <a class="go" href="/terminal">→ open</a></li>
        <li><span class="k">nutrione</span>nutrition tracking with YOLOv8
            food recognition.</li>
        <li><span class="k">plant monitor</span>IoT + LSTM watering
            predictions on ESP32 sensors.</li>
        <li><span class="k">llm reports</span>automated executive reporting
            with the Claude API.</li>
        <li><span class="k">scheduling app</span>constraint-solving course
            scheduler, licensed by two universities.</li>
        <li><span class="k">time tracker</span>enterprise time tracking on
            the Workday Marketplace. <a class="go" href="https://marketplace.workday.com">→ marketplace</a></li>
      </ul>
    </section>

    <section id="writing">
      <h2>Writing</h2>
      <ul class="entries">
        {posts.map((post) => (
          <li>
            <span class="date">{fmt(post.data.publishDate)}</span>
            <a href={`/blog/${post.slug}`}>{post.data.title}</a>
          </li>
        ))}
      </ul>
      <p class="more"><a href="/blog">→ all posts</a> · <a href="/journal">→ journal</a></p>
    </section>

    <section id="resume">
      <h2>Resume</h2>
      <p>
        <a href="/Bryce_Keeler_Resume.pdf">pdf</a> ·
        <a href="/resume">html</a>
      </p>
    </section>

    <section id="contact">
      <h2>Contact</h2>
      <p>
        <a href="mailto:Bryce@BryceKeeler.com">email</a> ·
        <a href="https://github.com/BryceKeeler720">github</a> ·
        <a href="https://www.linkedin.com/in/bryce-keeler720/">linkedin</a> ·
        <a href="/rss.xml">rss</a>
      </p>
    </section>

    <footer>© 2026</footer>
  </div>
</BaseLayout>

<style>
  :global(html) { scroll-behavior: smooth; }
  :global(body) { padding-inline: 16px; }

  pre { margin: 0; font-family: inherit; white-space: pre; }
  a { color: var(--ink); }
  a:hover { background: var(--bone); color: var(--void); text-decoration: none; }

  /* ── Background cathedral (fixed, full page) ───── */
  #cathedral {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    display: flex;
    align-items: flex-end;
  }
  #cathedral pre {
    font-size: 11px;
    line-height: 1.0;
    color: var(--ghost);
  }

  /* ── Left index ─────────────────────────────────── */
  #index {
    position: fixed;
    top: 0;
    left: 0;
    width: calc(20ch + 32px);
    height: 100vh;
    padding: 2.5rem 16px;
    z-index: 2;
    font-size: 0.85rem;
  }
  #index .label {
    color: var(--dim);
    letter-spacing: 0.3ch;
    margin-bottom: 0.5rem;
  }
  #index ul { list-style: none; margin: 0; padding: 0; }
  #index li { white-space: pre; }
  #index .tree { color: var(--faint); }
  #index a {
    color: var(--dim);
    text-decoration: none;
    padding: 0.05rem 0.4ch;
  }
  #index a:hover { background: var(--bone); color: var(--void); }
  #index a.active { color: var(--bone); }
  #index a.active::before { content: "▸ "; }
  #index .foot {
    position: absolute;
    bottom: 2rem;
    left: 16px;
    color: var(--faint);
    font-size: 0.75rem;
    letter-spacing: 0.15ch;
  }

  /* ── Page column (overlaid on the art) ──────────── */
  .page {
    position: relative;
    z-index: 1;
    margin-left: calc(20ch + 48px);
    max-width: 100ch;
    padding-block: 2.5rem 4rem;
  }

  .masthead { margin-bottom: 1rem; }
  .masthead h1 {
    margin: 0;
    font-size: 2.1rem;
    font-weight: normal;
    color: var(--bone);
    letter-spacing: 0.5ch;
  }
  .masthead .sub {
    color: var(--dim);
    letter-spacing: 0.25ch;
    font-size: 0.85rem;
    text-transform: uppercase;
    margin-top: 0.3rem;
  }

  section { scroll-margin-top: 2rem; margin-top: 2.8rem; }
  h2 {
    font-size: 1rem;
    font-weight: normal;
    color: var(--bone);
    letter-spacing: 0.4ch;
    text-transform: uppercase;
    margin: 0 0 0.8rem;
  }
  h2::before { content: "// "; color: var(--dim); }
  p { max-width: 78ch; margin: 0 0 0.8rem; }
  .more { color: var(--dim); font-size: 0.85rem; margin-top: 0.8rem; }

  .entries { list-style: none; margin: 0; padding: 0; max-width: 88ch; }
  .entries li {
    padding: 0.45rem 0;
    border-bottom: 1px dashed var(--ghost);
  }
  .entries .k {
    color: var(--bone);
    font-weight: bold;
    letter-spacing: 0.1ch;
  }
  .entries .k::after { content: " — "; color: var(--faint); font-weight: normal; }
  .entries .date { color: var(--dim); white-space: nowrap; margin-right: 1.5ch; }
  .entries .go { white-space: nowrap; }

  footer {
    margin-top: 4rem;
    color: var(--dim);
    font-size: 0.8rem;
    letter-spacing: 0.2ch;
  }

  @media (max-width: 980px) {
    #index {
      position: static;
      width: auto;
      height: auto;
      padding: 1.5rem 0 0;
    }
    #index .foot { display: none; }
    #index ul { display: flex; flex-wrap: wrap; gap: 0.2rem 1.2rem; }
    #index .tree { display: none; }
    .page { margin-left: 0; }
    #cathedral pre { opacity: 0.55; }
  }
</style>

<script is:inline>
/* ── noise kit ─────────────────────────────────────── */
function bkHash(x, y, s) {
  let h = Math.imul(x, 374761393) ^ Math.imul(y, 668265263) ^ Math.imul(s, 2246822519);
  h = Math.imul(h ^ (h >>> 13), 1274126177);
  return ((h ^ (h >>> 16)) >>> 0) / 4294967296;
}
function bkSstep(t) { return t * t * (3 - 2 * t); }
function bkVnoise(x, y, s) {
  const xi = Math.floor(x), yi = Math.floor(y);
  const xf = bkSstep(x - xi), yf = bkSstep(y - yi);
  const a = bkHash(xi, yi, s), b = bkHash(xi + 1, yi, s);
  const c = bkHash(xi, yi + 1, s), d = bkHash(xi + 1, yi + 1, s);
  return a + (b - a) * xf + (c - a) * yf + (a - b - c + d) * xf * yf;
}

/* ── background cathedral: sketchy inked spires ─────
   Full-page backdrop; the main spire peaks at ~3/4 of
   the viewport width. */
function renderCathedral() {
  const el = document.querySelector('#cathedral pre');
  if (!el) return;
  const seed = 7;
  // measure real cell size so spire positions stay true viewport fractions
  el.textContent = '@@@@@@@@@@';
  const probe = el.getBoundingClientRect();
  const charW = probe.width / 10 || 6.6;
  const charH = probe.height || 11;
  const rows = Math.floor(window.innerHeight / charH);
  const cols = Math.min(700, Math.ceil(window.innerWidth / charW));

  // [center fx, half-width fx, height] — main spire at 0.75
  const steeples = [
    [0.75, 0.072, 1.00],
    [0.615, 0.055, 0.72],
    [0.865, 0.052, 0.78],
    [0.54, 0.042, 0.48],
    [0.945, 0.040, 0.52],
    [0.675, 0.034, 0.60],
    [0.810, 0.034, 0.56],
  ];
  const grid = [];
  for (let y = 0; y < rows; y++) grid.push(new Array(cols).fill(' '));

  const prof = new Array(cols);
  for (let x = 0; x < cols; x++) {
    const fx = x / cols;
    let h = 0.12;
    for (const [c, w, ht] of steeples) {
      const d = Math.abs(fx - c) / w;
      if (d < 0.45) {
        const t = 1 - d / 0.45;
        h = Math.max(h, ht * (0.74 + 0.26 * t * t));
      }
      if (d < 0.70) h = Math.max(h, ht * 0.60);
      if (d < 1.00) h = Math.max(h, ht * 0.44 * (1.15 - d * 0.4));
    }
    // confine the complex to the right side; fade base wall at both ends
    const envL = bkSstep(Math.max(0, Math.min(1, (fx - 0.42) / 0.12)));
    const envR = bkSstep(Math.max(0, Math.min(1, (1.0 - fx) / 0.045)));
    h *= envL * (0.3 + 0.7 * envR);
    h += (bkVnoise(x * 0.35, 0, seed) - 0.5) * 0.04;
    prof[x] = Math.max(0.0, Math.min(0.995, h));
  }

  for (let x = 0; x < cols; x++) {
    if (prof[x] < 0.03) continue;
    const topY = Math.floor(rows * (1 - prof[x]));
    const topL = Math.floor(rows * (1 - (prof[x - 1] ?? 0)));
    const topR = Math.floor(rows * (1 - (prof[x + 1] ?? 0)));
    for (let y = topY; y < rows; y++) {
      const depth = (y - topY) / Math.max(1, rows - topY);
      const n = bkVnoise(x * 0.4, y * 0.4, seed + 1);
      const g = bkVnoise(x * 0.09, y * 0.8, seed + 2);
      const fine = bkHash(x, y, seed + 3);

      if (y < topL && y < topR) { grid[y][x] = fine > 0.5 ? '|' : '!'; continue; }
      if (y < topL) { grid[y][x] = '/'; continue; }
      if (y < topR) { grid[y][x] = '\\'; continue; }
      if (y === topY) { grid[y][x] = fine > 0.6 ? '^' : (fine > 0.3 ? 'A' : 'n'); continue; }

      // sketchy dropout — white gashes like unfinished linework
      const gash = bkVnoise(x * 0.22, y * 0.18, seed + 9);
      if (gash > 0.72 || fine > 0.955) { grid[y][x] = fine > 0.5 ? ' ' : '.'; continue; }

      // pointed windows: dark masses on loose vertical rhythm
      const wphase = (x * 5 + (seed * 3 | 0)) % 11;
      const isWin = wphase <= 1 && depth > 0.18 && n > 0.35;

      let v = n * 0.55 + g * 0.45 + depth * 0.30;
      if (isWin) v += 0.35;
      let ch;
      if (v > 0.92) ch = '@';
      else if (v > 0.80) ch = fine > 0.5 ? '&' : '%';
      else if (v > 0.70) ch = '#';
      else if (v > 0.60) ch = fine > 0.5 ? '(' : '|';
      else if (v > 0.50) ch = fine > 0.5 ? '/' : '\\';
      else if (v > 0.42) ch = fine > 0.5 ? '!' : ';';
      else if (v > 0.34) ch = ':';
      else ch = fine > 0.5 ? '.' : "'";
      if ((y + ((x * 0.06) | 0)) % 9 === 0 && depth > 0.12 && depth < 0.9 && fine > 0.35 && v > 0.4) ch = '=';
      grid[y][x] = ch;
    }
  }
  for (const [c, , ht] of steeples) {
    if (ht < 0.6) continue;
    const x = Math.floor(c * cols);
    const topY = Math.floor(rows * (1 - prof[x]));
    if (topY - 1 >= 0) grid[topY - 1][x] = '+';
  }
  el.textContent = grid.map((r) => r.join('')).join('\n');
}

renderCathedral();
let bkRto;
window.addEventListener('resize', () => {
  clearTimeout(bkRto);
  bkRto = setTimeout(renderCathedral, 150);
});

/* ── scroll-spy for the index ─────────────────────── */
(function () {
  const links = {};
  document.querySelectorAll('#index a[data-sec]').forEach((a) => { links[a.dataset.sec] = a; });
  const obs = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) {
        Object.values(links).forEach((a) => a.classList.remove('active'));
        links[e.target.id]?.classList.add('active');
      }
    });
  }, { rootMargin: '-20% 0px -60% 0px' });
  document.querySelectorAll('section[id]').forEach((s) => obs.observe(s));
})();
</script>
