<style>
  :global(html) { scroll-behavior: smooth; }
  :global(body) { padding-inline: 16px; }

  pre { margin: 0; font-family: inherit; white-space: pre; }
  a { color: var(--ink); }
  a:hover { background: var(--bone); color: var(--void); text-decoration: none; }

  /* ── Background cathedral (fixed, full page) ───── */
  #cathedral {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    display: flex;
    align-items: flex-end;
  }
  #cathedral pre {
    font-size: 11px;
    line-height: 1.0;
    color: var(--ghost);
  }

  /* ── Left index ─────────────────────────────────── */
  #index {
    position: fixed;
    top: 0;
    left: 0;
    width: calc(24ch + 32px);
    height: 100vh;
    padding: 2.5rem 16px;
    z-index: 2;
    font-size: 0.8rem;
    overflow-y: auto;
  }
  #index .label {
    color: var(--dim);
    letter-spacing: 0.3ch;
    margin-bottom: 0.6rem;
  }
  #index .json { line-height: 1.55; }
  #index .brace, #index .p { color: var(--faint); }
  #index .row { white-space: nowrap; }
  /* .ln spans are injected at runtime, so they need :global */
  #index :global(.ln) {
    display: inline-block;
    width: 3ch;
    text-align: right;
    margin-right: 1.5ch;
    color: var(--faint);
    user-select: none;
  }
  #index .jline.d1 :global(.ln) { margin-right: 3ch; }
  #index .jline.d2 :global(.ln) { margin-right: 5ch; }
  #index :global(.ln.cur) { color: var(--bone); }
  #index a {
    color: var(--dim);
    text-decoration: none;
  }
  #index a:hover { background: var(--bone); color: var(--void); }
  #index a.key.active { color: var(--bone); font-weight: bold; }
  #index .tog {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    color: var(--faint);
    cursor: pointer;
  }
  #index .tog:hover { color: var(--bone); }
  #index .children { list-style: none; margin: 0; padding: 0; }
  #index .children .leaf { color: var(--faint); }
  #index .close { padding-left: 0; }
  #index .foot {
    position: absolute;
    bottom: 2rem;
    left: 16px;
    color: var(--faint);
    font-size: 0.75rem;
    letter-spacing: 0.15ch;
  }

  /* ── Page column (overlaid on the art) ──────────── */
  .page {
    position: relative;
    z-index: 1;
    margin-left: calc(24ch + 48px);
    max-width: 100ch;
    padding-block: 3rem 15vh;
  }

  .masthead { margin-bottom: 3rem; }
  .masthead h1 {
    margin: 0;
    font-size: 2.1rem;
    font-weight: normal;
    color: var(--bone);
    letter-spacing: 0.5ch;
  }
  .masthead .sub {
    color: var(--dim);
    letter-spacing: 0.25ch;
    font-size: 0.85rem;
    text-transform: uppercase;
    margin-top: 0.3rem;
  }

  section { scroll-margin-top: 6rem; margin-top: 4rem; }
  h2 {
    font-size: 1rem;
    font-weight: normal;
    color: var(--bone);
    letter-spacing: 0.4ch;
    text-transform: uppercase;
    margin: 0 0 0.8rem;
  }
  h2::before { content: "// "; color: var(--dim); }
  .vlinks { list-style: none; margin: 1rem 0 0; padding: 0; }
  .vlinks li { padding: 0.2rem 0; }
  p { max-width: 78ch; margin: 0 0 0.8rem; }

  .entries { list-style: none; margin: 0; padding: 0; max-width: 88ch; }
  .entries li {
    padding: 0.45rem 0;
    border-bottom: 1px dashed var(--ghost);
  }
  .entries .k {
    color: var(--bone);
    font-weight: bold;
    letter-spacing: 0.1ch;
  }
  .entries .k::after { content: " — "; color: var(--faint); font-weight: normal; }
  .entries .date { color: var(--dim); white-space: nowrap; margin-right: 1.5ch; }
  .entries .go { white-space: nowrap; }

  footer {
    margin-top: 4rem;
    color: var(--dim);
    font-size: 0.8rem;
    letter-spacing: 0.2ch;
  }

  @media (max-width: 980px) {
    #index {
      position: static;
      width: auto;
      height: auto;
      padding: 1.5rem 0 0;
      overflow: visible;
    }
    #index .foot { display: none; }
    #index .json { display: flex; flex-wrap: wrap; gap: 0.2rem 1.4ch; }
    #index .node { padding-left: 0; }
    #index .brace, #index .p, #index .tog, #index .children, #index .close, #index :global(.ln) { display: none; }
    .page { margin-left: 0; }
    #cathedral pre { opacity: 0.55; }
  }
</style>

<script is:inline>
/* ── background cathedral, rendered donut.c-style ───
   A real 3D model this time: a point cloud sampled over boxes,
   pitched roofs, pyramid + cone spires and a half-cylinder apse,
   each point carrying its surface normal. Every frame the cloud is
   yaw-rotated (slow turntable), perspective-projected onto the
   character grid, z-buffered, and shaded against a fixed light
   through the classic ".,-~:;=!*#$@" luminance ramp. */
(function () {
  const el = document.querySelector('#cathedral pre');
  if (!el) return;

  const LUM = '.,-~:;=!*#$@';
  const STEP = 0.2; // surface sample spacing, model units

  /* ── point cloud ── */
  const px = [], py = [], pz = [], nX = [], nY = [], nZ = [], bst = [];
  function pt(x, y, z, nx, ny, nz, b) {
    const l = Math.hypot(nx, ny, nz) || 1;
    px.push(x); py.push(y); pz.push(z);
    nX.push(nx / l); nY.push(ny / l); nZ.push(nz / l);
    bst.push(b || 0);
  }
  function quad(o, u, v, n, boost) {
    const nu = Math.max(1, Math.ceil(Math.hypot(u[0], u[1], u[2]) / STEP));
    const nv = Math.max(1, Math.ceil(Math.hypot(v[0], v[1], v[2]) / STEP));
    for (let i = 0; i <= nu; i++) for (let j = 0; j <= nv; j++) {
      const a = i / nu, c = j / nv;
      pt(o[0] + u[0] * a + v[0] * c, o[1] + u[1] * a + v[1] * c, o[2] + u[2] * a + v[2] * c,
        n[0], n[1], n[2], boost ? boost(a, c) : 0);
    }
  }
  // box: cx,cz center, y0 ground; window boosts per face
  function box(cx, y0, cz, sx, sy, sz, w) {
    const hx = sx / 2, hz = sz / 2;
    w = w || {};
    quad([cx + hx, y0, cz - hz], [0, sy, 0], [0, 0, sz], [1, 0, 0], w.posx);
    quad([cx - hx, y0, cz - hz], [0, sy, 0], [0, 0, sz], [-1, 0, 0], w.negx);
    quad([cx - hx, y0, cz + hz], [0, sy, 0], [sx, 0, 0], [0, 0, 1], w.posz);
    quad([cx - hx, y0, cz - hz], [0, sy, 0], [sx, 0, 0], [0, 0, -1], w.negz);
    quad([cx - hx, y0 + sy, cz - hz], [sx, 0, 0], [0, 0, sz], [0, 1, 0]);
  }
  // triangle fan helper for gables & pyramid faces
  function tri(base, apexY, half, fixed, axis) {
    const nA = Math.max(1, Math.ceil((apexY - base[1]) / STEP));
    for (let i = 0; i <= nA; i++) {
      const a = i / nA, w = half * (1 - a);
      const nC = Math.max(1, Math.ceil((2 * w) / STEP));
      for (let j = 0; j <= nC; j++) {
        const c = -w + (2 * w) * (j / nC);
        if (axis === 'x') pt(base[0] + c, base[1] + a * (apexY - base[1]), base[2], fixed[0], fixed[1], fixed[2]);
        else pt(base[0], base[1] + a * (apexY - base[1]), base[2] + c, fixed[0], fixed[1], fixed[2]);
      }
    }
  }
  // pitched roof, ridge along z
  function roofZ(cx, y1, cz, sx, sz, h) {
    const hx = sx / 2, hz = sz / 2;
    quad([cx + hx, y1, cz - hz], [-hx, h, 0], [0, 0, sz], [h, hx, 0]);
    quad([cx - hx, y1, cz - hz], [hx, h, 0], [0, 0, sz], [-h, hx, 0]);
    tri([cx, y1, cz - hz], y1 + h, hx, [0, 0, -1], 'x');
    tri([cx, y1, cz + hz], y1 + h, hx, [0, 0, 1], 'x');
  }
  // pitched roof, ridge along x
  function roofX(cx, y1, cz, sx, sz, h) {
    const hx = sx / 2, hz = sz / 2;
    quad([cx - hx, y1, cz + hz], [0, h, -hz], [sx, 0, 0], [0, hz, h]);
    quad([cx - hx, y1, cz - hz], [0, h, hz], [sx, 0, 0], [0, hz, -h]);
    tri([cx - hx, y1, cz], y1 + h, hz, [-1, 0, 0], 'z');
    tri([cx + hx, y1, cz], y1 + h, hz, [1, 0, 0], 'z');
  }
  // 4-sided pyramid spire
  function pyramid(cx, y0, cz, half, h) {
    for (const [dx, dz] of [[1, 0], [-1, 0], [0, 1], [0, -1]]) {
      const nA = Math.max(1, Math.ceil(Math.hypot(h, half) / STEP));
      for (let i = 0; i <= nA; i++) {
        const a = i / nA, w = half * (1 - a);
        const nC = Math.max(1, Math.ceil((2 * w) / STEP));
        for (let j = 0; j <= nC; j++) {
          const c = -w + (2 * w) * (j / nC);
          pt(cx + dx * w + (dz !== 0 ? c : 0), y0 + a * h, cz + dz * w + (dx !== 0 ? c : 0),
            dx * h, half, dz * h);
        }
      }
    }
  }
  // smooth cone spire
  function cone(cx, y0, cz, r, h) {
    const nA = Math.max(2, Math.ceil(Math.hypot(h, r) / STEP));
    for (let i = 0; i <= nA; i++) {
      const t = i / nA, rr = r * (1 - t);
      const nT = Math.max(3, Math.ceil((2 * Math.PI * rr) / STEP));
      for (let j = 0; j < nT; j++) {
        const th = (j / nT) * Math.PI * 2;
        pt(cx + rr * Math.cos(th), y0 + t * h, cz + rr * Math.sin(th),
          Math.cos(th) * h, r, Math.sin(th) * h);
      }
    }
  }
  // half-cylinder apse (rounded east end) + conical half-roof
  function apse(cx, y0, cz, r, h, roofH) {
    const nYr = Math.ceil(h / STEP), nT = Math.ceil((Math.PI * r) / STEP);
    for (let i = 0; i <= nYr; i++) for (let j = 0; j <= nT; j++) {
      const th = (j / nT) * Math.PI;
      const win = ((j / nT) * 5) % 1;
      const b = (i / nYr > 0.3 && i / nYr < 0.75 && win > 0.35 && win < 0.65) ? 0.45 : 0;
      pt(cx + r * Math.cos(th), y0 + (i / nYr) * h, cz + r * Math.sin(th),
        Math.cos(th), 0, Math.sin(th), b);
    }
    const nA = Math.ceil(Math.hypot(roofH, r) / STEP);
    for (let i = 0; i <= nA; i++) {
      const t = i / nA, rr = r * (1 - t);
      const nT2 = Math.max(2, Math.ceil((Math.PI * rr) / STEP));
      for (let j = 0; j <= nT2; j++) {
        const th = (j / nT2) * Math.PI;
        pt(cx + rr * Math.cos(th), y0 + h + t * roofH, cz + rr * Math.sin(th),
          Math.cos(th) * roofH, r, Math.sin(th) * roofH);
      }
    }
  }
  // lancet windows along a wall: a = height frac, c = length frac
  function lancets(nWin, lo, hi) {
    lo = lo ?? 0.22; hi = hi ?? 0.72;
    return (a, c) => {
      if (a < lo || a > hi) return 0;
      const ph = (c * nWin) % 1;
      const t = (a - lo) / (hi - lo);
      const half = t < 0.7 ? 0.16 : 0.16 * (1 - (t - 0.7) / 0.3);
      return Math.abs(ph - 0.5) < half ? 0.5 : 0;
    };
  }
  // rose window disc on the west front
  function rose(cy, r) {
    return (a, c) => {
      const d = Math.hypot(a - cy, c - 0.5);
      if (d < r * 0.35) return 0.5;
      if (d < r) return ((Math.atan2(a - cy, c - 0.5) * 8 / Math.PI) % 2 + 2) % 2 < 1 ? 0.5 : 0.15;
      return 0;
    };
  }

  /* assemble (y up, ground y=0, west front at -z) */
  box(0, 0, -2, 9, 11, 30, { posx: lancets(9), negx: lancets(9), negz: rose(0.62, 0.30) });
  roofZ(0, 11, -2, 9, 30, 4.5);
  box(0, 0, 3, 20, 10, 7, { negz: lancets(3), posz: lancets(3) });
  roofX(0, 10, 3, 20, 7, 4);
  for (const tx of [-3.6, 3.6]) {
    const tw = lancets(1, 0.5, 0.85);
    box(tx, 0, -17.8, 5.4, 17, 5.4, { negz: tw, posx: tw, negx: tw });
    pyramid(tx, 17, -17.8, 2.9, 6.5);
  }
  cone(0, 13.5, 3, 3.1, 16.5); // central crossing spire, apex y=30
  apse(0, 0, 13, 4.5, 9, 4);

  const N = px.length;
  const PX = Float32Array.from(px), PY = Float32Array.from(py), PZ = Float32Array.from(pz);
  const NXA = Float32Array.from(nX), NYA = Float32Array.from(nY), NZA = Float32Array.from(nZ);
  const BS = Float32Array.from(bst);
  // per-point sketch dither, fixed so the texture doesn't flicker
  const DI = new Float32Array(N), SKIP = new Uint8Array(N);
  for (let i = 0; i < N; i++) {
    let h = Math.imul(i, 2654435761) >>> 0; h = ((h ^ (h >>> 15)) * 2246822519) >>> 0;
    const r = (h >>> 8) / 16777216 - 0.5;
    SKIP[i] = r > 0.44 ? 1 : 0; // sketchy dropout
    DI[i] = r * 0.15;
  }

  /* ── camera / projection ── */
  const K2 = 110, CY = 14, PITCH = -0.07, MODEL_H = 30;
  const L = [0.60, 0.42, -0.68];
  { const l = Math.hypot(L[0], L[1], L[2]); L[0] /= l; L[1] /= l; L[2] /= l; }
  const cosP = Math.cos(PITCH), sinP = Math.sin(PITCH);

  let cols = 0, rows = 0, cell = 0.6, K1 = 0, xc = 0, yc = 0;
  let grid = null, zb = null;
  function measure() {
    el.textContent = '@@@@@@@@@@';
    const probe = el.getBoundingClientRect();
    const charW = probe.width / 10 || 6.6;
    const charH = probe.height || 11;
    cell = charW / charH;
    rows = Math.floor(window.innerHeight / charH);
    cols = Math.min(700, Math.ceil(window.innerWidth / charW));
    K1 = (rows * 0.82 * K2) / (cell * MODEL_H);
    xc = cols * 0.68;                       // complex sits right, like before
    yc = rows - 2 - (K1 * cell * CY) / K2;  // ground line near the bottom edge
    grid = new Array(cols * rows);
    zb = new Float32Array(cols * rows);
  }

  function render(yaw) {
    const cosY = Math.cos(yaw), sinY = Math.sin(yaw);
    grid.fill(' ');
    zb.fill(0);
    for (let i = 0; i < N; i++) {
      if (SKIP[i]) continue;
      const x0 = PX[i] * cosY + PZ[i] * sinY;
      const z0 = -PX[i] * sinY + PZ[i] * cosY;
      const y0 = PY[i] - CY;
      const y1 = y0 * cosP - z0 * sinP;
      const z1 = y0 * sinP + z0 * cosP + K2;
      const ooz = 1 / z1;
      const xp = Math.round(xc + K1 * ooz * x0);
      const yp = Math.round(yc - K1 * cell * ooz * y1);
      if (xp < 0 || xp >= cols || yp < 0 || yp >= rows) continue;
      const idx = yp * cols + xp;
      if (zb[idx] !== 0 && ooz <= zb[idx]) continue;
      zb[idx] = ooz;
      const nx0 = NXA[i] * cosY + NZA[i] * sinY;
      const nz0 = -NXA[i] * sinY + NZA[i] * cosY;
      const ny1 = NYA[i] * cosP - nz0 * sinP;
      const nz1 = NYA[i] * sinP + nz0 * cosP;
      const d = nx0 * L[0] + ny1 * L[1] + nz1 * L[2];
      let lum = d > 0 ? 0.12 + 0.58 * d : 0.12 + 0.10 * d;
      lum = Math.min(1, Math.max(0.02, lum + DI[i] + BS[i]));
      grid[idx] = LUM[Math.min(LUM.length - 1, Math.floor(lum * LUM.length))];
    }
    const out = [];
    for (let y = 0; y < rows; y++) out.push(grid.slice(y * cols, (y + 1) * cols).join(''));
    el.textContent = out.join('\n');
  }

  /* ── slow turntable, static under reduced motion ── */
  let yaw = 2.45, raf = 0, last = 0;
  const media = window.matchMedia('(prefers-reduced-motion: reduce)');
  function tick(now) {
    raf = requestAnimationFrame(tick);
    if (now - last < 1000 / 24) return;
    last = now;
    render(yaw);
    yaw += 0.004;
  }
  function start() {
    cancelAnimationFrame(raf);
    measure();
    if (media.matches) { render(yaw); return; }
    raf = requestAnimationFrame(tick);
  }
  media.addEventListener('change', start);
  start();

  let bkRto;
  window.addEventListener('resize', () => {
    clearTimeout(bkRto);
    bkRto = setTimeout(start, 150);
  });
})();

/* ── scroll-spy for the index ─────────────────────── */
(function () {
  const links = {};
  document.querySelectorAll('#index a[data-sec]').forEach((a) => { links[a.dataset.sec] = a; });
  const secs = Array.from(document.querySelectorAll('section[id]'));
  if (!secs.length) return;

  const nodes = {};
  document.querySelectorAll('#index .node.obj').forEach((n) => { nodes[n.dataset.node] = n; });

  function setExpanded(node, open) {
    const tog = node.querySelector('.tog');
    const bkt = node.querySelector('.bkt');
    const comma = node.querySelector('.comma');
    const children = node.querySelector('.children');
    const close = node.querySelector('.close');
    tog.hidden = open;
    if (comma) comma.hidden = open;
    bkt.hidden = !open;
    children.hidden = !open;
    close.hidden = !open;
    tog.setAttribute('aria-expanded', String(open));
  }

  document.querySelectorAll('#index .jline').forEach((l) => {
    const ln = document.createElement('span');
    ln.className = 'ln';
    l.insertBefore(ln, l.firstChild);
  });

  // vim relativenumber: the active key's line shows its absolute
  // number, every other visible line shows its distance from it
  function renumber() {
    const lines = Array.from(document.querySelectorAll('#index .jline'))
      .filter((l) => l.offsetParent !== null);
    const activeEl = document.querySelector('#index .key.active');
    let ai = activeEl ? lines.findIndex((l) => l.contains(activeEl)) : -1;
    if (ai < 0) ai = 0;
    lines.forEach((l, i) => {
      const ln = l.querySelector('.ln');
      ln.textContent = i === ai ? String(i + 1) : String(Math.abs(i - ai));
      ln.classList.toggle('cur', i === ai);
    });
  }

  Object.values(nodes).forEach((n) => {
    n.querySelector('.tog').addEventListener('click', () => { setExpanded(n, true); renumber(); });
    n.querySelector('.close').addEventListener('click', () => { setExpanded(n, false); renumber(); });
  });

  function setActive(id) {
    Object.values(links).forEach((a) => a.classList.toggle('active', a.dataset.sec === id));
    // the active section's node unfolds; the rest fold shut
    Object.entries(nodes).forEach(([sec, n]) => setExpanded(n, sec === id));
    renumber();
  }

  function spy() {
    const doc = document.documentElement;
    const maxScroll = Math.max(1, doc.scrollHeight - window.innerHeight);
    const ref = window.innerHeight * 0.35;
    const n = secs.length;
    // each section activates when its top crosses the reading line, but
    // never later than its even share of the reachable scroll range —
    // so short pages still hand every section a scroll band
    let current = secs[0].id;
    secs.forEach((sec, i) => {
      const natural = sec.getBoundingClientRect().top + window.scrollY - ref;
      const cap = (maxScroll * i) / Math.max(1, n - 1);
      if (window.scrollY >= Math.min(natural, cap) - 1) current = sec.id;
    });
    setActive(current);
  }

  let ticking = false;
  window.addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => { spy(); ticking = false; });
  }, { passive: true });

  // highlight immediately on click, before the smooth scroll lands
  Object.values(links).forEach((a) => {
    a.addEventListener('click', () => setActive(a.dataset.sec));
  });

  spy();
})();
</script>
