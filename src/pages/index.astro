<style>
  :global(html) { scroll-behavior: smooth; }
  :global(body) { padding-inline: 16px; }

  pre { margin: 0; font-family: inherit; white-space: pre; }
  a { color: var(--ink); }
  a:hover { background: var(--bone); color: var(--void); text-decoration: none; }

  /* ── Background cathedral (fixed, full page) ───── */
  #cathedral {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
  }
  #cathedral pre {
    position: absolute;
    left: 0;
    bottom: 0;
    font-size: 11px;
    line-height: 1.0;
  }
  /* depth by color, three planes: the far layer sinks toward the
     page ground, the mid layer holds just under ghost, and the
     main mass runs brightest at street level, fading as it climbs */
  #cathedral .bg-far {
    color: color-mix(in srgb, var(--ghost) 85%, var(--void));
  }
  #cathedral .bg-mid {
    color: color-mix(in srgb, var(--faint) 75%, var(--ghost));
  }
  #cathedral .bg-main {
    color: var(--dim);
  }
  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    #cathedral .bg-main {
      background: linear-gradient(
        to top,
        color-mix(in srgb, var(--ink) 25%, var(--dim)) 0%,
        var(--dim) 45%,
        color-mix(in srgb, var(--faint) 55%, var(--dim)) 82%,
        var(--faint) 100%
      );
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
  }

  /* ── Left index ─────────────────────────────────── */
  #index {
    position: fixed;
    top: 0;
    left: 0;
    width: calc(24ch + 32px);
    height: 100vh;
    padding: 2.5rem 16px;
    z-index: 2;
    font-size: 0.8rem;
    overflow-y: auto;
  }
  #index .label {
    color: var(--dim);
    letter-spacing: 0.3ch;
    margin-bottom: 0.6rem;
  }
  #index .json { line-height: 1.55; }
  #index .brace, #index .p { color: var(--faint); }
  #index .row { white-space: nowrap; }
  /* .ln spans are injected at runtime, so they need :global */
  #index :global(.ln) {
    display: inline-block;
    width: 3ch;
    text-align: right;
    margin-right: 1.5ch;
    color: var(--faint);
    user-select: none;
  }
  #index .jline.d1 :global(.ln) { margin-right: 3ch; }
  #index .jline.d2 :global(.ln) { margin-right: 5ch; }
  #index :global(.ln.cur) { color: var(--bone); }
  #index a {
    color: var(--dim);
    text-decoration: none;
  }
  #index a:hover { background: var(--bone); color: var(--void); }
  #index a.key.active { color: var(--bone); font-weight: bold; }
  #index .tog {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    color: var(--faint);
    cursor: pointer;
  }
  #index .tog:hover { color: var(--bone); }
  #index .children { list-style: none; margin: 0; padding: 0; }
  #index .children .leaf { color: var(--faint); }
  #index .close { padding-left: 0; }
  #index .foot {
    position: absolute;
    bottom: 2rem;
    left: 16px;
    color: var(--faint);
    font-size: 0.75rem;
    letter-spacing: 0.15ch;
  }

  /* ── Page column (overlaid on the art) ──────────── */
  .page {
    position: relative;
    z-index: 1;
    margin-left: calc(24ch + 48px);
    /* keep the column clear of the cathedral (art begins ~45vw):
       tighter measure + slightly smaller type than the site base */
    font-size: 14px;
    max-width: min(80ch, 44vw);
    padding-block: 3rem 15vh;
  }
  @media (max-width: 1500px) {
    .page { max-width: 80ch; }
  }

  .masthead { margin-bottom: 3rem; }
  .masthead h1 {
    margin: 0;
    font-size: 2.1rem;
    font-weight: normal;
    color: var(--bone);
    letter-spacing: 0.5ch;
  }
  .masthead .sub {
    color: var(--dim);
    letter-spacing: 0.25ch;
    font-size: 0.85rem;
    text-transform: uppercase;
    margin-top: 0.3rem;
  }

  section { scroll-margin-top: 6rem; margin-top: 4rem; }
  h2 {
    font-size: 1rem;
    font-weight: normal;
    color: var(--bone);
    letter-spacing: 0.4ch;
    text-transform: uppercase;
    margin: 0 0 0.8rem;
  }
  h2::before { content: "// "; color: var(--dim); }
  .vlinks { list-style: none; margin: 1rem 0 0; padding: 0; }
  .vlinks li { padding: 0.2rem 0; }
  p { max-width: 78ch; margin: 0 0 0.8rem; }

  .entries { list-style: none; margin: 0; padding: 0; max-width: 88ch; }
  .entries li {
    padding: 0.45rem 0;
    border-bottom: 1px dashed var(--ghost);
  }
  .entries .k {
    color: var(--bone);
    font-weight: bold;
    letter-spacing: 0.1ch;
  }
  .entries .k::after { content: " — "; color: var(--faint); font-weight: normal; }
  .entries .k.solo::after { content: none; }
  .entries .date { color: var(--dim); white-space: nowrap; margin-right: 1.5ch; }
  .entries .go { white-space: nowrap; }

  footer {
    margin-top: 4rem;
    color: var(--dim);
    font-size: 0.8rem;
    letter-spacing: 0.2ch;
  }
  #live-line { margin-bottom: 0.5rem; }

  @media (max-width: 980px) {
    #index {
      position: static;
      width: auto;
      height: auto;
      padding: 1.5rem 0 0;
      overflow: visible;
    }
    #index .foot { display: none; }
    #index .json { display: flex; flex-wrap: wrap; gap: 0.2rem 1.4ch; }
    #index .node { padding-left: 0; }
    #index .brace, #index .p, #index .tog, #index .children, #index .close, #index :global(.ln) { display: none; }
    .page { margin-left: 0; }
    #cathedral pre { opacity: 0.7; }
  }
</style>

<script is:inline>
/* ── noise kit ─────────────────────────────────────── */
function bkHash(x, y, s) {
  let h = Math.imul(x, 374761393) ^ Math.imul(y, 668265263) ^ Math.imul(s, 2246822519);
  h = Math.imul(h ^ (h >>> 13), 1274126177);
  return ((h ^ (h >>> 16)) >>> 0) / 4294967296;
}
function bkSstep(t) { return t * t * (3 - 2 * t); }
function bkVnoise(x, y, s) {
  const xi = Math.floor(x), yi = Math.floor(y);
  const xf = bkSstep(x - xi), yf = bkSstep(y - yi);
  const a = bkHash(xi, yi, s), b = bkHash(xi + 1, yi, s);
  const c = bkHash(xi, yi + 1, s), d = bkHash(xi + 1, yi + 1, s);
  return a + (b - a) * xf + (c - a) * yf + (a - b - c + d) * xf * yf;
}

/* ── background cathedral: sketchy inked spires ─────
   Same static composition as always — main spire peaks at ~3/4 of
   the viewport width — with depth built from three layers: a hazy
   distant complex behind the skyline, directional light shading
   (lit west flanks, shadowed east flanks) across the main mass,
   and a loose buttress rhythm in the walls. */
function renderCathedral() {
  const el = document.querySelector('#cathedral .bg-main');
  const midEl = document.querySelector('#cathedral .bg-mid');
  const farEl = document.querySelector('#cathedral .bg-far');
  if (!el || !midEl || !farEl) return;
  const seed = 7;
  // measure real cell size so spire positions stay true viewport fractions
  el.textContent = '@@@@@@@@@@';
  const probe = el.getBoundingClientRect();
  const charW = probe.width / 10 || 6.6;
  const charH = probe.height || 11;
  const rows = Math.floor(window.innerHeight / charH);
  const cols = Math.min(700, Math.ceil(window.innerWidth / charW));

  // [center fx, half-width fx, height] — main spire at 0.75
  const steeples = [
    [0.75, 0.072, 1.00],
    [0.615, 0.055, 0.72],
    [0.865, 0.052, 0.78],
    [0.54, 0.042, 0.48],
    [0.945, 0.040, 0.52],
    [0.675, 0.034, 0.60],
    [0.810, 0.034, 0.56],
  ];
  // a second complex one block back, filling gaps between the main spires
  const midSteeples = [
    [0.455, 0.040, 0.55],
    [0.500, 0.046, 0.72],
    [0.560, 0.038, 0.60],
    [0.645, 0.042, 0.78],
    [0.720, 0.036, 0.85],
    [0.838, 0.045, 0.80],
    [0.925, 0.042, 0.74],
    [0.990, 0.038, 0.60],
  ];
  // and a distant third, hazing out on the horizon
  const farSteeples = [
    [0.415, 0.048, 0.42],
    [0.480, 0.040, 0.55],
    [0.575, 0.050, 0.62],
    [0.660, 0.040, 0.50],
    [0.715, 0.046, 0.66],
    [0.788, 0.044, 0.60],
    [0.903, 0.048, 0.64],
    [0.975, 0.040, 0.46],
  ];

  const grid = [];
  const midGrid = [];
  const farGrid = [];
  for (let y = 0; y < rows; y++) {
    grid.push(new Array(cols).fill(' '));
    midGrid.push(new Array(cols).fill(' '));
    farGrid.push(new Array(cols).fill(' '));
  }

  function buildProfile(st, envLeftAt, baseH) {
    const prof = new Array(cols);
    for (let x = 0; x < cols; x++) {
      const fx = x / cols;
      let h = baseH;
      for (const [c, w, ht] of st) {
        const d = Math.abs(fx - c) / w;
        if (d < 0.45) {
          const t = 1 - d / 0.45;
          h = Math.max(h, ht * (0.74 + 0.26 * t * t));
        }
        if (d < 0.70) h = Math.max(h, ht * 0.60);
        if (d < 1.00) h = Math.max(h, ht * 0.44 * (1.15 - d * 0.4));
      }
      // confine the complex to the right side; fade base wall at both ends
      const envL = bkSstep(Math.max(0, Math.min(1, (fx - envLeftAt) / 0.12)));
      const envR = bkSstep(Math.max(0, Math.min(1, (1.0 - fx) / 0.045)));
      h *= envL * (0.3 + 0.7 * envR);
      h += (bkVnoise(x * 0.35, 0, seed) - 0.5) * 0.04;
      prof[x] = Math.max(0.0, Math.min(0.995, h));
    }
    return prof;
  }

  const prof = buildProfile(steeples, 0.42, 0.12);
  const midProf = buildProfile(midSteeples, 0.38, 0.11);
  const farProf = buildProfile(farSteeples, 0.34, 0.10);

  // pass 1 — distant layer: hazy and sparse, no detail; it survives
  // only where it rises above everything nearer
  for (let x = 0; x < cols; x++) {
    if (farProf[x] < 0.03) continue;
    const topY = Math.floor(rows * (1 - farProf[x]));
    for (let y = topY; y < rows; y++) {
      const fine = bkHash(x, y, seed + 11);
      if (fine > 0.62) continue; // heavy dropout reads as haze
      const n = bkVnoise(x * 0.3, y * 0.5, seed + 12);
      farGrid[y][x] = y === topY ? '~' : (n > 0.6 ? ';' : n > 0.42 ? ':' : n > 0.25 ? '-' : ',');
    }
  }

  // pass 2 — middle layer: firmer than the distance, still loose;
  // it occludes the far layer beneath its own skyline
  for (let x = 0; x < cols; x++) {
    if (midProf[x] < 0.03) continue;
    const topY = Math.floor(rows * (1 - midProf[x]));
    const topL = Math.floor(rows * (1 - (midProf[x - 1] ?? 0)));
    const topR = Math.floor(rows * (1 - (midProf[x + 1] ?? 0)));
    for (let y = topY; y < rows; y++) {
      farGrid[y][x] = ' ';
      const fine = bkHash(x, y, seed + 21);
      if (y < topL && y < topR) { midGrid[y][x] = fine > 0.5 ? '|' : '!'; continue; }
      if (y < topL) { midGrid[y][x] = '/'; continue; }
      if (y < topR) { midGrid[y][x] = '\\'; continue; }
      if (y === topY) { midGrid[y][x] = fine > 0.5 ? '^' : 'n'; continue; }
      if (fine > 0.86) continue; // lighter dropout than the far haze
      const n = bkVnoise(x * 0.35, y * 0.45, seed + 22);
      const depth = (y - topY) / Math.max(1, rows - topY);
      const v = n * 0.7 + depth * 0.25;
      midGrid[y][x] = v > 0.78 ? '!' : v > 0.62 ? '=' : v > 0.48 ? ';' : v > 0.36 ? ':' : v > 0.24 ? '-' : ',';
    }
  }

  // pass 3 — main complex, inked over both back layers
  for (let x = 0; x < cols; x++) {
    if (prof[x] < 0.03) continue;
    const fx = x / cols;

    // directional light from the upper-left: which flank of the
    // nearest spire is this column on?
    let side = 0, nearest = 1e9;
    for (const [c, w] of steeples) {
      const d = (fx - c) / w;
      if (Math.abs(d) < nearest) { nearest = Math.abs(d); side = Math.max(-1, Math.min(1, d)); }
    }
    const shade = -side * 0.11; // lit west flank, shadowed east flank

    const topY = Math.floor(rows * (1 - prof[x]));
    const topL = Math.floor(rows * (1 - (prof[x - 1] ?? 0)));
    const topR = Math.floor(rows * (1 - (prof[x + 1] ?? 0)));
    for (let y = topY; y < rows; y++) {
      // the main mass occludes both back layers, gashes included
      farGrid[y][x] = ' ';
      midGrid[y][x] = ' ';
      const depth = (y - topY) / Math.max(1, rows - topY);
      const n = bkVnoise(x * 0.4, y * 0.4, seed + 1);
      const g = bkVnoise(x * 0.09, y * 0.8, seed + 2);
      const fine = bkHash(x, y, seed + 3);

      if (y < topL && y < topR) { grid[y][x] = fine > 0.5 ? '|' : '!'; continue; }
      if (y < topL) { grid[y][x] = '/'; continue; }
      if (y < topR) { grid[y][x] = '\\'; continue; }
      if (y === topY) { grid[y][x] = fine > 0.6 ? '^' : (fine > 0.3 ? 'A' : 'n'); continue; }

      // sketchy dropout — white gashes like unfinished linework
      const gash = bkVnoise(x * 0.22, y * 0.18, seed + 9);
      if (gash > 0.72 || fine > 0.955) { grid[y][x] = fine > 0.5 ? ' ' : '.'; continue; }

      // pointed windows: dark masses on loose vertical rhythm
      const wphase = (x * 5 + (seed * 3 | 0)) % 11;
      const isWin = wphase <= 1 && depth > 0.18 && n > 0.35;

      let v = n * 0.55 + g * 0.45 + depth * 0.30 + shade;
      // buttress rhythm: heavier vertical piers on a loose beat
      if ((x + ((seed * 5) | 0)) % 13 < 2 && depth > 0.22) v += 0.09;
      if (isWin) v += 0.35;
      let ch;
      if (v > 0.92) ch = '@';
      else if (v > 0.80) ch = fine > 0.5 ? '&' : '%';
      else if (v > 0.70) ch = '#';
      else if (v > 0.60) ch = fine > 0.5 ? '(' : '|';
      else if (v > 0.50) ch = fine > 0.5 ? '/' : '\\';
      else if (v > 0.42) ch = fine > 0.5 ? '!' : ';';
      else if (v > 0.34) ch = ':';
      else ch = fine > 0.5 ? '.' : "'";
      if ((y + ((x * 0.06) | 0)) % 9 === 0 && depth > 0.12 && depth < 0.9 && fine > 0.35 && v > 0.4) ch = '=';
      grid[y][x] = ch;
    }
  }
  for (const [c, , ht] of steeples) {
    if (ht < 0.6) continue;
    const x = Math.floor(c * cols);
    const topY = Math.floor(rows * (1 - prof[x]));
    if (topY - 1 >= 0) grid[topY - 1][x] = '+';
  }
  el.textContent = grid.map((r) => r.join('')).join('\n');
  midEl.textContent = midGrid.map((r) => r.join('')).join('\n');
  farEl.textContent = farGrid.map((r) => r.join('')).join('\n');
}

renderCathedral();
let bkRto;
window.addEventListener('resize', () => {
  clearTimeout(bkRto);
  bkRto = setTimeout(renderCathedral, 150);
});

/* ── scroll-spy for the index ─────────────────────── */
(function () {
  const links = {};
  document.querySelectorAll('#index a[data-sec]').forEach((a) => { links[a.dataset.sec] = a; });
  const secs = Array.from(document.querySelectorAll('section[id]'));
  if (!secs.length) return;

  const nodes = {};
  document.querySelectorAll('#index .node.obj').forEach((n) => { nodes[n.dataset.node] = n; });

  function setExpanded(node, open) {
    const tog = node.querySelector('.tog');
    const bkt = node.querySelector('.bkt');
    const comma = node.querySelector('.comma');
    const children = node.querySelector('.children');
    const close = node.querySelector('.close');
    tog.hidden = open;
    if (comma) comma.hidden = open;
    bkt.hidden = !open;
    children.hidden = !open;
    close.hidden = !open;
    tog.setAttribute('aria-expanded', String(open));
  }

  document.querySelectorAll('#index .jline').forEach((l) => {
    const ln = document.createElement('span');
    ln.className = 'ln';
    l.insertBefore(ln, l.firstChild);
  });

  // vim relativenumber: the active key's line shows its absolute
  // number, every other visible line shows its distance from it
  function renumber() {
    const lines = Array.from(document.querySelectorAll('#index .jline'))
      .filter((l) => l.offsetParent !== null);
    const activeEl = document.querySelector('#index .key.active');
    let ai = activeEl ? lines.findIndex((l) => l.contains(activeEl)) : -1;
    if (ai < 0) ai = 0;
    lines.forEach((l, i) => {
      const ln = l.querySelector('.ln');
      ln.textContent = i === ai ? String(i + 1) : String(Math.abs(i - ai));
      ln.classList.toggle('cur', i === ai);
    });
  }

  Object.values(nodes).forEach((n) => {
    n.querySelector('.tog').addEventListener('click', () => { setExpanded(n, true); renumber(); });
    n.querySelector('.close').addEventListener('click', () => { setExpanded(n, false); renumber(); });
  });

  function setActive(id) {
    Object.values(links).forEach((a) => a.classList.toggle('active', a.dataset.sec === id));
    // the active section's node unfolds; the rest fold shut
    Object.entries(nodes).forEach(([sec, n]) => setExpanded(n, sec === id));
    renumber();
  }

  function spy() {
    const doc = document.documentElement;
    const maxScroll = Math.max(1, doc.scrollHeight - window.innerHeight);
    const ref = window.innerHeight * 0.35;
    const n = secs.length;
    // each section activates when its top crosses the reading line, but
    // never later than its even share of the reachable scroll range —
    // so short pages still hand every section a scroll band
    let current = secs[0].id;
    secs.forEach((sec, i) => {
      const natural = sec.getBoundingClientRect().top + window.scrollY - ref;
      const cap = (maxScroll * i) / Math.max(1, n - 1);
      if (window.scrollY >= Math.min(natural, cap) - 1) current = sec.id;
    });
    setActive(current);
  }

  let ticking = false;
  window.addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => { spy(); ticking = false; });
  }, { passive: true });

  // highlight immediately on click, before the smooth scroll lands
  Object.values(links).forEach((a) => {
    a.addEventListener('click', () => setActive(a.dataset.sec));
  });

  spy();
})();

/* ── live status line: bot + homelab ──────────────── */
(async function () {
  const el = document.getElementById('live-line');
  if (!el) return;
  const bits = [];
  try {
    const r = await fetch('/api/trading/data');
    if (r.ok) {
      const d = await r.json();
      const v = d.portfolio && d.portfolio.totalValue;
      const hist = Array.isArray(d.history) ? d.history : [];
      const dayStart = new Date(); dayStart.setHours(0, 0, 0, 0);
      const base = hist.find((h) => new Date(h.timestamp) >= dayStart);
      if (v && base && base.totalValue) {
        const pct = ((v - base.totalValue) / base.totalValue) * 100;
        bits.push('bot: ' + (pct >= 0 ? '+' : '') + pct.toFixed(2) + '% today');
      }
    }
  } catch (e) { /* offline is fine */ }
  try {
    const r = await fetch('/api/homelab/data');
    if (r.ok) {
      const d = await r.json();
      const cs = d.latest && d.latest.containers;
      if (Array.isArray(cs) && cs.length) {
        const up = cs.filter((c) => c.status === 'running').length;
        bits.push('homelab: ' + up + '/' + cs.length + ' up');
      }
    }
  } catch (e) { /* offline is fine */ }
  if (bits.length) { el.textContent = bits.join(' · '); el.hidden = false; }
})();
</script>
