---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  crumb?: string;
  crumbHref?: string;
}

const { title, description, crumb = 'home', crumbHref = '/' } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="doc">
    <nav class="crumbs"><a href={crumbHref}>← {crumb}</a></nav>
    <slot />
    <footer>© 2026</footer>
  </div>
</BaseLayout>

<style is:global>
  .doc {
    max-width: 92ch;
    margin: 0 auto;
    padding: 2.5rem 16px 4rem;
  }
  .doc a { color: var(--ink); }
  .doc a:hover { background: var(--bone); color: var(--void); text-decoration: none; }

  .doc .crumbs { color: var(--dim); font-size: 0.85rem; margin-bottom: 2rem; }
  .doc .crumbs a { color: var(--dim); text-decoration: none; }
  .doc .crumbs a:hover { background: var(--bone); color: var(--void); }

  .doc h1 {
    margin: 0;
    font-size: 1.8rem;
    font-weight: normal;
    color: var(--bone);
    letter-spacing: 0.5ch;
    text-transform: uppercase;
  }
  .doc .sub {
    color: var(--dim);
    letter-spacing: 0.25ch;
    font-size: 0.85rem;
    text-transform: uppercase;
    margin-top: 0.3rem;
  }

  .doc section { margin-top: 2.8rem; }
  .doc h2 {
    font-size: 1rem;
    font-weight: normal;
    color: var(--bone);
    letter-spacing: 0.4ch;
    text-transform: uppercase;
    margin: 0 0 0.8rem;
  }
  .doc h2::before { content: "// "; color: var(--dim); }
  .doc p { max-width: 78ch; margin: 0 0 0.8rem; color: var(--kana-fg-dim); }

  .doc .entries { list-style: none; margin: 0; padding: 0; }
  .doc .entries > li {
    padding: 0.45rem 0;
    border-bottom: 1px dashed var(--ghost);
    color: var(--kana-fg-dim);
  }
  .doc .entries .k {
    color: var(--bone);
    font-weight: bold;
    letter-spacing: 0.1ch;
  }
  .doc .entries .k::after { content: " — "; color: var(--faint); font-weight: normal; }

  .doc pre.diagram {
    margin: 0.5rem 0 0;
    color: var(--dim);
    font-size: 12px;
    line-height: 1.35;
    overflow-x: auto;
  }

  .doc .bullets {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    font-size: 0.9rem;
    color: var(--kana-fg-dim);
  }
  .doc .bullets li { padding: 0.15rem 0 0.15rem 2ch; position: relative; }
  .doc .bullets li::before { content: "·"; position: absolute; left: 0.5ch; color: var(--faint); }

  /* markdown content */
  .doc .prose { max-width: 78ch; color: var(--kana-fg-dim); line-height: 1.75; }
  .doc .prose h2 {
    font-size: 1rem;
    font-weight: normal;
    color: var(--bone);
    letter-spacing: 0.4ch;
    text-transform: uppercase;
    margin: 2.4rem 0 0.8rem;
  }
  .doc .prose h2::before { content: "// "; color: var(--dim); }
  .doc .prose h3 {
    font-size: 0.9rem;
    color: var(--bone);
    letter-spacing: 0.2ch;
    text-transform: uppercase;
    margin: 1.8rem 0 0.6rem;
  }
  .doc .prose p { margin: 0 0 1rem; max-width: 78ch; }
  .doc .prose a { color: var(--ink); }
  .doc .prose a:hover { background: var(--bone); color: var(--void); }
  .doc .prose code {
    background: var(--kana-bg-light);
    padding: 0.1em 0.4ch;
    font-size: 0.9em;
  }
  .doc .prose pre {
    background: var(--kana-bg-dim);
    border: 1px solid var(--ghost);
    padding: 1rem 1.2rem;
    overflow-x: auto;
    margin: 0 0 1rem;
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .doc .prose pre code { background: none; padding: 0; }
  .doc .prose blockquote {
    margin: 0 0 1rem;
    padding-left: 2ch;
    border-left: 2px solid var(--faint);
    color: var(--dim);
  }
  .doc .prose ul, .doc .prose ol { margin: 0 0 1rem; padding-left: 3ch; }
  .doc .prose li { margin: 0.2rem 0; }
  .doc .prose img { max-width: 100%; }
  .doc .prose hr { border: none; border-top: 1px dashed var(--faint); margin: 2rem 0; }
  .doc .prose table { border-collapse: collapse; margin: 0 0 1rem; }
  .doc .prose th, .doc .prose td { border: 1px solid var(--ghost); padding: 0.3rem 1ch; }

  .doc .meta { color: var(--dim); font-size: 0.85rem; margin-top: 0.5rem; }
  .doc .tags { color: var(--faint); font-size: 0.8rem; }

  .doc footer {
    margin-top: 4rem;
    color: var(--dim);
    font-size: 0.8rem;
    letter-spacing: 0.2ch;
  }
</style>
